[flake8]
# Recommend matching the black line length (119, set in pyproject.toml),
# rather than using the flake8 default of 79:
max-line-length = 120
extend-ignore =
    # See https://github.com/PyCQA/pycodestyle/issues/373
    E203,W503
exclude =
    .git,
    __pycache__,
    .venv,
    build,
    dist,
    *.egg-info,
    .ipynb_checkpoints,
    # Retired code, kept for reference only
    msi/deprecated,
    # Superseded by the coverage stage of run_inference.py --sample_posterior
    msi/apps/deprecated
